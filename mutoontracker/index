                q_mumtaz: " ممتاز ", q_jayyid: " جید ", q_weak: " کمزور ", q_absent: " غیر حاضر "
            },
            ar: {
                appTitle: "متابع المتون", start: "بسم الله",
                historyTitle: "سجل الطالب", addRecord: "إضافة سجل", aboutApp: "عن التطبيق",
                supportUs: "ادعمنا", supportText: "هذا التطبيق صدقة جارية. ساهم في استمراره:",
                donateBtn: "تبرع (Razorpay)", shareBtn: "مشاركة التطبيق", privacy: "سياسة الخصوصية",
                privacyLink: "زيارة الموقع", deleteTitle: "حذف؟", yesDelete: "نعم، حذف",
                cancel: "إلغاء", newGrade: "صف جديد", editGrade: "تعديل الصف", gradeName: "اسم الصف:",
                save: "حفظ", newStudent: "طالب جديد", editStudent: "تعديل الطالب",
                teacherName: "اسم المعلم:", date: "التاريخ:", subject: "الكتاب/المادة:", lesson: "الدرس:", quality: "التقدير:",
                newRecord: "تسجيل جديد",
                // Translation EMPTY for Arabic
                welcomeMsg: "", 
                studentsCount: "طلاب", newStudentStatus: "طالب جديد",
                delGradeMsg: "حذف الصف سيؤدي لحذف جميع الطلاب.",
                delStMsg: "حذف الطالب وجميع سجلاته؟",
                delRecMsg: "حذف السجل من التطبيق؟",
                enterName: "أدخل الاسم", enterAge: "أدخل العمر", enterGName: "أدخل اسم الصف",
                q_mumtaz: " ممتاز ", q_jayyid: " جيد ", q_weak: " ضعيف ", q_absent: " غائب "
            }
        };

        let currentLang = localStorage.getItem('m_lang') || 'en';

        // --- DATA ---
        let grades = JSON.parse(localStorage.getItem('m_grades')) || [{id: 'g1', name: 'Hifz Class'}];
        let students = JSON.parse(localStorage.getItem('m_students')) || [];

        let currentView = 'welcome';
        let activeGradeId = null;
        let activeStudentId = null;
        let deleteType = null; let deleteTargetId = null;

        document.getElementById('repDate').valueAsDate = new Date();
        const savedTeacher = localStorage.getItem('m_teacher_name');
        if(savedTeacher) document.getElementById('teacherName').value = savedTeacher;

        // Apply Language on Load
        document.getElementById('langSelector').value = currentLang;
        applyLanguage(currentLang);

        // --- LANGUAGE LOGIC (WITH FONT SWITCH & HIDE TRANSLATION) ---
        function changeLanguage() {
            const lang = document.getElementById('langSelector').value;
            currentLang = lang;
            localStorage.setItem('m_lang', lang);
            applyLanguage(lang);
        }

        function applyLanguage(lang) {
            // 1. Set Direction & Font
            if(lang === 'ur' || lang === 'en') {
                document.body.style.fontFamily = "'JameelLocal', sans-serif";
                document.body.setAttribute('dir', lang === 'ur' ? 'rtl' : 'ltr');
                document.getElementById('welcomeHadith').style.display = 'block'; // Show Trans
            } else if(lang === 'ar') {
                document.body.style.fontFamily = "'AmiriLocal', serif";
                document.body.setAttribute('dir', 'rtl');
                document.getElementById('welcomeHadith').style.display = 'none'; // Hide Trans
            }

            // 2. Update Static Text
            document.querySelectorAll('[data-key]').forEach(el => {
                const key = el.getAttribute('data-key');
                if(i18n[lang][key]) el.innerText = i18n[lang][key];
            });

            // 3. Update Dynamic Placeholders
            document.getElementById('welcomeHadith').innerText = i18n[lang].welcomeMsg;
            document.getElementById('stNameInput').placeholder = i18n[lang].enterName;
            document.getElementById('stAgeInput').placeholder = i18n[lang].enterAge;
            document.getElementById('gradeNameInput').placeholder = i18n[lang].enterGName;
            document.getElementById('teacherName').placeholder = i18n[lang].enterName;

            // 4. Update Select Options (Quality)
            const qOpts = document.getElementById('repQuality').options;
            qOpts[0].text = i18n[lang].q_mumtaz;
            qOpts[1].text = i18n[lang].q_jayyid;
            qOpts[2].text = i18n[lang].q_weak;
            qOpts[3].text = i18n[lang].q_absent;

            // Re-render lists to update text there
            if(currentView === 'grades') renderGrades();
            if(currentView === 'students') renderStudents();
            if(currentView === 'history') renderHistory();
        }

        // --- NAV ---
        function enterApp() { navigateTo('grades'); }

        function navigateTo(viewName, data = null, addHistory = true) {
            document.querySelectorAll('[id^="view-"]').forEach(el => el.style.display = 'none');
            document.getElementById('welcomeScreen').style.display = 'none';

            if(viewName === 'grades') {
                document.getElementById('view-grades').style.display = 'block';
                renderGrades();
                if(addHistory) history.pushState({page: 'grades'}, "Grades", "#grades");
            } 
            else if(viewName === 'students') {
                document.getElementById('view-students').style.display = 'block';
                activeGradeId = data;
                const g = grades.find(x => x.id === activeGradeId);
                document.getElementById('headerGradeName').innerText = g ? g.name : i18n[currentLang].studentsCount;
                renderStudents();
                if(addHistory) history.pushState({page: 'students', id: data}, "Students", "#students");
            } 
            else if(viewName === 'history') {
                document.getElementById('view-history').style.display = 'block';
                activeStudentId = data;
                renderHistory();
                if(addHistory) history.pushState({page: 'history', id: data}, "History", "#history");
            }
            else if(viewName === 'info') {
                document.getElementById('view-info').style.display = 'block';
                if(addHistory) history.pushState({page: 'info'}, "About", "#info");
            }
            currentView = viewName;
        }

        window.onpopstate = function(event) {
            if (event.state) {
                if(event.state.page === 'grades') navigateTo('grades', null, false);
                else if(event.state.page === 'students') navigateTo('students', event.state.id, false);
                else if(event.state.page === 'history') navigateTo('history', event.state.id, false);
                else if(event.state.page === 'info') navigateTo('info', null, false);
            } else {
                document.querySelectorAll('[id^="view-"]').forEach(el => el.style.display = 'none');
                document.getElementById('welcomeScreen').style.display = 'flex';
                currentView = 'welcome';
            }
        };
        function handleBack() { window.history.back(); }

        // --- RENDERERS ---
        function renderGrades() {
            const container = document.getElementById('gradesContainer');
            container.innerHTML = '';
            grades.forEach(g => {
                const count = students.filter(s => s.gradeId === g.id).length;
                container.innerHTML += `
                    <div class="grade-card">
                        <div style="flex-grow:1" onclick="navigateTo('students', '${g.id}')">
                            <div class="card-title">${g.name}</div>
                            <div class="card-subtitle">${count} ${i18n[currentLang].studentsCount}</div>
                        </div>
                        <div class="grade-actions">
                            <div class="action-btn" onclick="openEditGradeModal(event, '${g.id}')"><svg class="icon icon-edit"><use href="#icon-edit"></use></svg></div>
                            <div class="action-btn" onclick="askDelete(event, 'grade', '${g.id}')"><svg class="icon icon-trash"><use href="#icon-trash"></use></svg></div>
                        </div>
                    </div>`;
            });
        }

        function renderStudents() {
            const container = document.getElementById('studentsListContainer');
            container.innerHTML = '';
            const list = students.filter(s => s.gradeId === activeGradeId);
            list.forEach(s => {
                const last = s.history && s.history.length > 0 ? s.history[0] : null;
                const status = last ? `${last.date}: ${last.lesson}` : i18n[currentLang].newStudentStatus;
                container.innerHTML += `
                    <div class="student-card">
                        <div style="flex-grow:1" onclick="navigateTo('history', '${s.id}')">
                            <div class="card-title">${s.name}</div>
                            <div class="card-subtitle">${status}</div>
                        </div>
                        <div class="grade-actions">
                            <div class="action-btn" onclick="openEditStudentModal(event, '${s.id}')"><svg class="icon icon-edit"><use href="#icon-edit"></use></svg></div>
                            <div class="action-btn" onclick="askDelete(event, 'student', '${s.id}')"><svg class="icon icon-trash"><use href="#icon-trash"></use></svg></div>
                        </div>
                    </div>`;
            });
        }

        function renderHistory() {
            const s = students.find(x => x.id === activeStudentId);
            document.getElementById('profileName').innerText = s.name;
            document.getElementById('profileAge').innerText = s.age ? s.age : '';
            const container = document.getElementById('historyContainer');
            container.innerHTML = '';
            
            s.history.forEach((h, idx) => {
                let cls = 'b-mumtaz', txt = i18n[currentLang].q_mumtaz;
                if(h.quality === 'Jayyid') { cls = 'b-jayyid'; txt = i18n[currentLang].q_jayyid; }
                if(h.quality === 'Weak') { cls = 'b-weak'; txt = i18n[currentLang].q_weak; }
                if(h.quality === 'Absent') { cls = 'b-absent'; txt = i18n[currentLang].q_absent; }
                let syncIcon = h.synced ? '✅' : '☁️';
                
                container.innerHTML += `
                    <div class="history-item ${cls}">
                        <div class="history-date">${h.date}</div>
                        <div style="color:#00796b; font-size:1.1rem;">${h.subject || ''}</div>
                        <div style="font-size:1.4rem; margin:2px 0;">${h.lesson}</div>
                        <div class="history-quality">${txt}</div>
                        <div class="sync-status">${syncIcon}</div>
                        <div class="del-entry" onclick="askDelete(event, 'history', ${idx})"><svg class="icon icon-trash"><use href="#icon-trash"></use></svg></div>
                    </div>`;
            });
        }

        // --- DELETE & MODALS ---
        function askDelete(e, type, id) {
            if(e) e.stopPropagation();
            deleteType = type; deleteTargetId = id;
            if(type === 'grade') document.getElementById('deleteMsg').innerText = i18n[currentLang].delGradeMsg;
            else if (type === 'student') document.getElementById('deleteMsg').innerText = i18n[currentLang].delStMsg;
            else document.getElementById('deleteMsg').innerText = i18n[currentLang].delRecMsg;
            openModal('deleteConfirmModal');
        }

        document.getElementById('confirmDeleteBtn').onclick = function() {
            if(deleteType === 'grade') {
                grades = grades.filter(x => x.id !== deleteTargetId);
                students = students.filter(s => s.gradeId !== deleteTargetId);
                localStorage.setItem('m_grades', JSON.stringify(grades));
                localStorage.setItem('m_students', JSON.stringify(students));
                renderGrades();
            } else if (deleteType === 'student') {
                students = students.filter(s => s.id !== deleteTargetId);
                localStorage.setItem('m_students', JSON.stringify(students));
                renderStudents();
            } else if (deleteType === 'history') {
                const s = students.find(x => x.id === activeStudentId);
                s.history.splice(deleteTargetId, 1);
                localStorage.setItem('m_students', JSON.stringify(students));
                renderHistory();
            }
            closeModal('deleteConfirmModal');
        };

        function openModal(id) { document.getElementById(id).style.display = 'flex'; }
        function closeModal(id) { document.getElementById(id).style.display = 'none'; }
        
        function openEditGradeModal(e, id = null) {
            if(e) e.stopPropagation();
            if(id) {
                const g = grades.find(x => x.id === id);
                document.getElementById('gradeIdInput').value = id;
                document.getElementById('gradeNameInput').value = g.name;
                document.getElementById('gradeModalTitle').innerText = i18n[currentLang].editGrade;
            } else {
                document.getElementById('gradeIdInput').value = "";
                document.getElementById('gradeNameInput').value = "";
                document.getElementById('gradeModalTitle').innerText = i18n[currentLang].newGrade;
            }
            openModal('gradeModal');
        }

        function openEditStudentModal(e, id = null) {
            if(e) e.stopPropagation();
            if(id) {
                const s = students.find(x => x.id === id);
                document.getElementById('stIdInput').value = id;
                document.getElementById('stNameInput').value = s.name;
                document.getElementById('stAgeInput').value = s.age;
                document.getElementById('stModalTitle').innerText = i18n[currentLang].editStudent;
            } else {
                document.getElementById('stIdInput').value = "";
                document.getElementById('stNameInput').value = "";
                document.getElementById('stAgeInput').value = "";
                document.getElementById('stModalTitle').innerText = i18n[currentLang].newStudent;
            }
            openModal('studentModal');
        }

        function saveGrade() {
            const name = document.getElementById('gradeNameInput').value;
            const id = document.getElementById('gradeIdInput').value;
            if(!name) return;
            if(id) { const idx = grades.findIndex(x => x.id === id); grades[idx].name = name; } 
            else { grades.push({id: Date.now().toString(), name: name}); }
            localStorage.setItem('m_grades', JSON.stringify(grades));
            closeModal('gradeModal'); renderGrades();
        }

        function saveStudent() {
            const name = document.getElementById('stNameInput').value;
            const age = document.getElementById('stAgeInput').value;
            const id = document.getElementById('stIdInput').value;
            if(!name) return;
            if(id) { const idx = students.findIndex(x => x.id === id); students[idx].name = name; students[idx].age = age; } 
            else { students.push({ id: Date.now().toString(), name: name, age: age, gradeId: activeGradeId, history: [] }); }
            localStorage.setItem('m_students', JSON.stringify(students));
            document.getElementById('stNameInput').value = ''; document.getElementById('stAgeInput').value = '';
            closeModal('studentModal'); renderStudents();
        }

        function openReportModal() { 
            document.getElementById('repDate').valueAsDate = new Date();
            openModal('reportModal');
        }

        function saveReport() {
            const teacher = document.getElementById('teacherName').value;
            if(!teacher) return;
            localStorage.setItem('m_teacher_name', teacher);
            const s = students.find(x => x.id === activeStudentId);
            const gradeObj = grades.find(g => g.id === s.gradeId);
            const newRecord = {
                date: document.getElementById('repDate').value,
                teacher: teacher,
                student: s.name,
                grade: gradeObj.name,
                subject: document.getElementById('repSubject').value,
                lesson: document.getElementById('repLesson').value,
                quality: document.getElementById('repQuality').value,
                synced: false
            };
            s.history.unshift(newRecord);
            localStorage.setItem('m_students', JSON.stringify(students));
            closeModal('reportModal'); renderHistory();
            if(GOOGLE_SCRIPT_URL) {
                fetch(GOOGLE_SCRIPT_URL, { method: "POST", mode: "no-cors", headers: { "Content-Type": "application/json" }, body: JSON.stringify(newRecord) })
                .then(() => { s.history[0].synced = true; localStorage.setItem('m_students', JSON.stringify(students)); renderHistory(); })
                .catch(err => console.log("Offline"));
            }
        }

        function openDonationLink() { window.open(RAZORPAY_LINK, '_system'); }
        function shareApp() {
            const shareData = { title: 'Mutoon Tracker', text: 'Mutoon Tracker App:', url: 'https://play.google.com/store/apps/details?id=com.umair.mutoontracker' };
            if (navigator.share) navigator.share(shareData).catch(console.error);
            else window.open(`https://wa.me/?text=${encodeURIComponent(shareData.text + " " + shareData.url)}`);
        }
    </script>
</body>
