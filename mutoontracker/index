                supportUs: "تعاون کریں", supportText: "یہ ایپ صدقہ جاریہ ہے۔ اس پروجیکٹ کو جاری رکھنے کے لیے مدد کریں:",
                donateBtn: "تعاون کریں (Razorpay)", shareBtn: "ایپ شیئر کریں", privacy: "پرائیویسی پالیسی",
